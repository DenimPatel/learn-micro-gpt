+// softmaxCrossEntropy computes -log(softmax(logits)[target]) as one tape
+// node. The max subtraction remains detached, matching softmax above.
+func softmaxCrossEntropy(logits []*Value, target int) *Value {
+	maxVal := math.Inf(-1)
+	for _, v := range logits {
+		if v.Data > maxVal {
+			maxVal = v.Data
+		}
+	}
+	expData := make([]float64, len(logits))
+	totalData := 0.0
+	for i, v := range logits {
+		e := math.Exp(v.Data - maxVal)
+		expData[i] = e
+		totalData += e
+	}
+	inverseTotal := math.Pow(totalData, -1)
+	children := make([]*Value, len(logits))
+	localGrads := make([]float64, len(logits))
+	for i, v := range logits {
+		children[i] = v
+		localGrads[i] = expData[i] * inverseTotal
+	}
+	localGrads[target] -= 1
+	return &Value{
+		Data:       -math.Log(expData[target] * inverseTotal),
+		Children:   children,
+		LocalGrads: localGrads,
+	}
+}
+
+// linearCrossEntropy fuses the final vocabulary projection and its
+// cross-entropy into one tape node. Rows are recorded in reverse order so the
+// hidden-state gradients accumulate in the same order as separate linear nodes.
+func linearCrossEntropy(x []*Value, w Matrix, target int) *Value {
+	expData := make([]float64, len(w))
+	for i, row := range w {
+		acc := 0.0
+		for j, xi := range x {
+			acc += row[j].Data * xi.Data
+		}
+		expData[i] = acc
+	}
+	maxVal := math.Inf(-1)
+	for _, logit := range expData {
+		if logit > maxVal {
+			maxVal = logit
+		}
+	}
+	totalData := 0.0
+	for i, logit := range expData {
+		expData[i] = math.Exp(logit - maxVal)
+		totalData += expData[i]
+	}
+	inverseTotal := 1 / totalData
+
+	nIn := len(x)
+	stride := 2 * nIn
+	childrenBacking := make([]*Value, len(w)*stride)
+	localGradsBacking := make([]float64, len(w)*stride)
+	for i := len(w) - 1; i >= 0; i-- {
+		probability := expData[i] * inverseTotal
+		if i == target {
+			probability--
+		}
+		row := w[i]
+		base := i * stride
+		for j, xi := range x {
+			childIndex := base + j
+			childrenBacking[childIndex] = row[j]
+			childrenBacking[childIndex+nIn] = xi
+			localGradsBacking[childIndex] = probability * xi.Data
+			localGradsBacking[childIndex+nIn] = probability * row[j].Data
+		}
+	}
+	return &Value{
+		Data:       -math.Log(expData[target] * inverseTotal),
+		Children:   childrenBacking,
+		LocalGrads: localGradsBacking,
+	}
 }
 
