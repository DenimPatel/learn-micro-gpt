+// attentionMix computes one attention head directly as a function of its
+// logits and values, recording the analytic softmax Jacobian on each output.
+func attentionMix(logits []*Value, values [][]*Value, start, width int) []*Value {
+	probabilities := make([]float64, len(logits))
+	maxVal := math.Inf(-1)
+	for _, logit := range logits {
+		if logit.Data > maxVal {
+			maxVal = logit.Data
+		}
+	}
+	total := 0.0
+	for i, logit := range logits {
+		probabilities[i] = math.Exp(logit.Data - maxVal)
+		total += probabilities[i]
+	}
+	inverseTotal := 1 / total
+	for i := range probabilities {
+		probabilities[i] *= inverseTotal
+	}
+
+	stride := 2 * len(logits)
+	childrenBacking := make([]*Value, width*stride)
+	localGradsBacking := make([]float64, width*stride)
+	out := make([]*Value, width)
+	for j := 0; j < width; j++ {
+		acc := 0.0
+		base := j * stride
+		for t, logit := range logits {
+			value := values[t][start+j]
+			acc += probabilities[t] * value.Data
+			childIndex := base + t
+			childrenBacking[childIndex] = logit
+			childrenBacking[childIndex+len(logits)] = value
+		}
+		for t := range logits {
+			childIndex := base + t
+			value := values[t][start+j]
+			localGradsBacking[childIndex] = probabilities[t] * (value.Data - acc)
+			localGradsBacking[childIndex+len(logits)] = probabilities[t]
+		}
+		out[j] = &Value{
+			Data:       acc,
+			Children:   childrenBacking[base : base+stride : base+stride],
+			LocalGrads: localGradsBacking[base : base+stride : base+stride],
+		}
 	}
 	return out
 }
