+static inline float exp_nonpositive(float x) {
+  if (x < -87.0f)
+    return 0.0f;
+
+  /* Truncation toward zero chooses n = ceil(x / log(2)), leaving
+   * r in [-log(2), 0]. */
+  int n = (int)(x * 1.4426950408889634f);
+  float r = x - (float)n * 0.6931471805599453f;
+  float p =
+      1.0f +
+      r * (1.0f + r *
+               (0.5f + r *
+                    (0.1666666716f + r *
+                         (0.0416666679f + r *
+                              (0.0083333338f + r * 0.0013888889f)))));
+
+  union {
+    int i;
+    float f;
+  } scale;
+  scale.i = (n + 127) << 23;
+  return p * scale.f;
+}
