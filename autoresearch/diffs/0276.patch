+static void count_sort_docs_by_length(int *indices, int n) {
+  static int sorted[MAX_DOCS];
+  int next[MAX_DOC_LEN + 1] = {0};
+
+  for (int i = 0; i < n; i++)
+    next[doc_lens[indices[i]]]++;
+
+  int offset = 0;
+  for (int len = 0; len <= MAX_DOC_LEN; len++) {
+    int count = next[len];
+    next[len] = offset;
+    offset += count;
+  }
+
+  for (int i = 0; i < n; i++) {
+    int doc = indices[i];
+    sorted[next[doc_lens[doc]]++] = doc;
+  }
+
+  memcpy(indices, sorted, (size_t)n * sizeof(sorted[0]));
+}
