+// attentionValues computes the softmax-weighted value reduction directly.
+// Each output node retains the complete softmax Jacobian with respect to every
+// logit, as well as the value operands, so the fused tape is exactly equivalent
+// to softmax followed by one dot product per output feature.
+func attentionValues(logits []*Value, values [][]*Value, offset, width int) []*Value {
+	maxVal := math.Inf(-1)
+	for _, v := range logits {
+		if v.Data > maxVal {
+			maxVal = v.Data
+		}
+	}
+
+	probabilities := make([]float64, len(logits))
+	totalData := 0.0
+	for i, v := range logits {
+		e := math.Exp(v.Data - maxVal)
+		probabilities[i] = e
+		totalData += e
+	}
+	inverseTotal := math.Pow(totalData, -1)
+	for i := range probabilities {
+		probabilities[i] *= inverseTotal
+	}
+
+	out := make([]*Value, width)
+	for j := 0; j < width; j++ {
+		acc := 0.0
+		children := make([]*Value, 0, 2*len(logits))
+		localGrads := make([]float64, 0, 2*len(logits))
+		for t, logit := range logits {
+			value := values[t][offset+j]
+			probability := probabilities[t]
+			acc += probability * value.Data
+			children = append(children, logit, value)
+			localGrads = append(localGrads,
+				probability*(1-probability)*value.Data,
+				probability,
+			)
+		}
+		out[j] = &Value{
+			Data:       acc,
+			Children:   children,
+			LocalGrads: localGrads,
+		}
+	}
+	return out
+}
