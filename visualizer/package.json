{
  "name": "learn-micro-gpt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Concept Atlas for Karpathy's 199-line microgpt.py",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "fmt": "prettier --write . && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "gen:content": "node --run ../tools/render_content.mjs"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "dagre": "^0.8.5",
    "katex": "^0.16.22",
    "marked": "^17.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.52",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
